<?xml version="1.0" encoding="UTF-8"?>
<project name="IJA-projekt" default="compile" basedir=".">
    
	<property name="src" location="./src/dama" />
    <property name="build" location="./build/dama" />
	<property name="lib" location="./lib" />
    <property name="dest" location="./dest" />

	   
    <target name="clean">
        <delete dir="${build}"/>	
        <delete dir="${dest}"/>	        
    </target> 
 
    <target name="compile" depends="clean">        
		<mkdir dir="${build}"/>		
		<javac 
            includeantruntime="false"
			srcdir="${src}"
            destdir="${build}"
			encoding="UTF-8"
            classpath="${lib}/junit-4.10.jar:${src}" />
	</target>
	
	<target name="jar" depends="clean,compile">
            <mkdir dir="${dest}"/>
            <jar destfile="${dest}/dama.jar" basedir="${build}">
                <manifest>
                    <attribute name="Main-Class" value="dama.Dama"/>
                    <attribute name="Class-Path" value="lib/junit-4.10.jar"/>
                </manifest>
            </jar>
            <mkdir dir="${dest}/lib"/>
            <copy file="${lib}/junit-4.10.jar" todir="${dest}/lib"/>
	</target>
		
		
		
	<target name="run" depends="jar">
        <java jar="${dest}/dama.jar" dir="${dest}" fork="true"/>
	</target>
	
	
    
    
</project>
 
 
 