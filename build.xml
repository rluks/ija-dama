<?xml version="1.0" encoding="UTF-8"?>
<project name="IJA-projekt" default="compile" basedir=".">

    <property name="src" location="./src/dama" />
    <property name="build" location="./build" />
    <property name="lib" location="./lib" />
    <property name="dest" location="./dest" />
    <property name="doc" location="./doc" />

    <property name="sourcefiles" value="./src/dama/Dama.java,
        ./src/dama/Player.java,
        ./src/dama/Roman.java,
        ./src/dama/TestDama.java,
        ./src/dama/io/Input.java,
        ./src/dama/io/NetworkSetup.java,
        ./src/dama/io/Output.java,
        ./src/dama/io/Turn.java,
        ./src/dama/operations/AI.java,
        ./src/dama/operations/Check.java,
        ./src/dama/operations/Moves.java,
        ./src/dama/state/Desk.java,
        ./src/dama/state/Figure.java,
        ./src/dama/state/Position.java,
        ./src/dama/state/Settings.java,
        ./src/gui/Fail.java,
        ./src/gui/Gui.java,
        ./src/gui/InsertNotation.java,
        ./src/gui/LoadGame.java,
        ./src/gui/NewGameSettings.java,
        ./src/gui/NewP2PGameSettings.java,
        ./src/gui/PlayerGui.java,
        ./src/gui/Selection.java,
        ./src/gui/Victory.java
        "/>


    <target name="clean">
        <delete dir="${build}"/>
        <delete dir="${dest}"/>
        <delete dir="${doc}"/>
    </target>

    <target name="compile" depends="clean">
        <mkdir dir="${build}"/>
        <javac
            includeantruntime="false"
            srcdir="${src}"
            destdir="${build}"
            encoding="UTF-8"
            classpath="${lib}/junit-4.10.jar:${src}" />
    </target>

    <target name="runtests" depends="clean, compile">
        <junit fork="yes" printsummary="on" showoutput="true" enableTestListenerEvents="true">
            <jvmarg value="-ea"/>
            <classpath>
                <pathelement path="${build}"/>
                <pathelement location="lib/junit-4.10.jar"/>
            </classpath>
            <!--<formatter type="plain"/>-->
            <test name="dama.TestDama"/> <!--outfile="testout"-->
        </junit>
    </target>

    <target name="javadoc">
        <mkdir dir="${doc}"/>
        <javadoc
            sourcepath="${src}"
            sourcefiles="${sourcefiles}"
            destdir="${doc}"
            classpath="${src}"
            encoding="UTF-8"
            author="true"
            windowtitle="Dama 2013"
        />
    </target>

    <target name="all" depends="clean,jar,javadoc">
    </target>


    <target name="jar" depends="clean,compile">
        <echo>Tvorim jar soubor</echo>
            <mkdir dir="${dest}"/>
            <jar destfile="${dest}/ija2013.jar" basedir="${build}">
                <manifest>
                    <attribute name="Main-Class" value="dama.Dama"/>
                    <attribute name="Class-Path" value="lib/junit-4.10.jar"/>
                    <attribute name="Class-Path" value="lib/Image.jar"/>
                </manifest>
            </jar>
            <mkdir dir="${dest}/lib"/>
            <copy file="${lib}/junit-4.10.jar" todir="${dest}/lib"/>
    </target>

    <!--
    <target name="test" depends="jar">
        <java jar="${dest}/ija2013.jar" dir="${dest}" fork="true"/>
    </target>
    -->


</project>


